# Ключ ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID голосов (ElevenLabs → Voices). По умолчанию бесплатные стандартные голоса:
VOICE_HERO=TX3LPaxmHKxFdv7VOQHJ     # Liam — молодой, живой
VOICE_SAVIOR=IKne3meq5aSn9XLyUdCD   # Charlie — низкий, уверенный
VOICE_NARRATOR=onwK4e9ZLuTAKqWW03F9 # Daniel — ровный, дикторский
# Многоязычная модель с русским (eleven_v3 понимает теги интонации [whispers] и т.п.)
MODEL_ID=eleven_v3

# --- Голоса через Gemini (Google AI Studio): нативный русский ---
# Ключ: https://aistudio.google.com/apikey  (лучше — переменной окружения среды, не в файле)
GEMINI_API_KEY=
TTS_PROVIDER=gemini
# Голоса Gemini (prebuilt). Пробники: npm run audio -- --provider=gemini --samples
GEMINI_VOICE_HERO=Puck
GEMINI_VOICE_SAVIOR=Charon
GEMINI_VOICE_NARRATOR=Iapetus
# GEMINI_TTS_MODEL=  # по умолчанию — первая доступная TTS-модель (flash)
